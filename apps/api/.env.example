# Port the API listens on.
PORT=5561

# Comma-separated list of origins allowed to call the API from a browser.
CORS_ORIGINS=http://localhost:5560

# Public origin of the API. Better Auth uses it for cookie/callback URLs.
BETTER_AUTH_URL=http://localhost:5561

# Secret used to sign sessions. Generate one with `openssl rand -base64 32`.
BETTER_AUTH_SECRET=

# Path to the SQLite database file.
DB_FILE_NAME=./db.sqlite

# Path to the Higgsfield CLI binary. Defaults to `higgsfield` on PATH.
HIGGSFIELD_CLI_PATH=higgsfield

# Timeout for each CLI command, in milliseconds.
HIGGSFIELD_CLI_TIMEOUT_MS=15000

# How long to cache the /status result, in milliseconds.
HIGGSFIELD_STATUS_CACHE_MS=10000
